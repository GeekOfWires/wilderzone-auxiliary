{
  "name": "tribes-proxy-check",
  "version": "1.0.0",
  "description": "VPN/proxy detection API for Tribes 2 game servers, with an admin panel. Cloudflare Worker + D1 + KV.",
  "author": "GeekOfWires <GeekOfWires@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:app && wrangler deploy",
    "build:app": "npm --prefix app run build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute tribes-proxy-check-db --local --file=migrations/0001_init.sql",
    "db:migrate": "wrangler d1 execute tribes-proxy-check-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
